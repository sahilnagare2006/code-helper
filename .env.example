# Copy this file to .env (same folder) and fill in your real keys.
# NEVER commit .env or paste keys into code, chat or screenshots.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=code-helper
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Full path to the cloned Naive_RAG folder (optional: defaults to ../Naive_RAG)
PROJECT_PATH=/full/path/to/assignment_2/Naive_RAG
# Set to 1 to add the optional Mermaid MCP server to the Architecture Mapper
ENABLE_MERMAID_MCP=0
